// Ícone e versão do OpenFrame.exe. Gerado pelo CMake (qt/src/app/CMakeLists.txt).
#include <winver.h>

IDI_ICON1 ICON "@OPENFRAME_ICO@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604B0"
        BEGIN
            VALUE "CompanyName", "OpenFrame\0"
            VALUE "FileDescription", "OpenFrame\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "OpenFrame\0"
            VALUE "LegalCopyright", "GPL-3.0-or-later\0"
            VALUE "OriginalFilename", "OpenFrame.exe\0"
            VALUE "ProductName", "OpenFrame\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
